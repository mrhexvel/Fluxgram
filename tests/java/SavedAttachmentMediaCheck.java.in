import java.io.File;
import java.nio.file.Files;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.HashSet;

public final class SavedAttachmentMediaCheck {
    private final int account = 0;

    SUPPORTED_METHOD

    SOURCE_METHODS

    private static void require(boolean result) {
        if (!result) {
            throw new AssertionError();
        }
    }

    public static void main(String[] args) throws Exception {
        SavedAttachmentMediaCheck archive = new SavedAttachmentMediaCheck();
        File root = new File(args[0]);
        File original = new File(root, "original.mp4");
        File alternate = new File(root, "alternate.mp4");
        TLRPC.Message message = new TLRPC.Message();
        message.media = new TLRPC.TL_messageMediaDocument();
        message.media.document = new TLRPC.Document();
        message.media.document.video = true;
        message.media.document.size = 100;
        FileLoader.loader.original = original;
        require(supported(message));

        message.media.document.video = false;
        message.media.document.voice = true;
        require(supported(message));
        message.media.ttl_seconds = Integer.MAX_VALUE;
        require(!supported(message));
        message.media.ttl_seconds = 0;
        message.dialog_id = Long.MAX_VALUE;
        require(!supported(message));
        message.dialog_id = 0;
        message.ttl_period = 30;
        require(!supported(message));
        message.ttl_period = 0;
        message.media.document.music = true;
        require(!supported(message));
        message.media.document.music = false;
        message.media.document.voice = false;
        message.media.document.video = true;
        require(supported(message));

        TLRPC.Document alt = new TLRPC.Document();
        alt.video = true;
        alt.size = 50;
        message.media.alt_documents.add(alt);
        FileLoader.loader.paths.put(alt, alternate);
        Files.write(original.toPath(), new byte[30]);
        Files.write(alternate.toPath(), new byte[50]);
        Source selected = archive.findSource(message, 100);
        require(selected != null && selected.file.equals(alternate) && selected.size == 50);
        require(archive.findSource(message, 49) == null);
        alt.mime_type = "application/x-mpegurl";
        require(archive.findSource(message, 100) == null);
        alt.mime_type = "video/mp4";

        FileLoader.loader.loading.add(alternate.getName());
        require(archive.findSource(message, 100) == null);
        FileLoader.loader.loading.clear();
        Files.write(original.toPath(), new byte[100]);
        selected = archive.findSource(message, 100);
        require(selected != null && selected.file.equals(original));
        selected = archive.findSource(message, 75);
        require(selected != null && selected.file.equals(alternate));

        require(original.delete());
        require(alternate.delete());
        message.media.document.video = false;
        message.media.document.voice = true;
        File voice = new File(root, "voice.ogg");
        Files.write(voice.toPath(), new byte[100]);
        message.attachPath = voice.getPath();
        selected = archive.findSource(message, 100);
        require(selected != null && selected.file.equals(voice));
        message.media.document = new TLRPC.TL_documentEncrypted();
        require(!supported(message));
    }
}

class TLRPC {
    static class Message {
        int ttl;
        int ttl_period;
        long dialog_id;
        String attachPath;
        Media media;
    }

    static class Media {
        int ttl_seconds;
        Object photo;
        Document document;
        ArrayList<Document> alt_documents = new ArrayList<>();
    }

    static class TL_messageMediaPhoto extends Media {
    }

    static class TL_messageMediaDocument extends Media {
    }

    static class TL_documentEncrypted extends Document {
    }

    static class Document {
        long size;
        String mime_type = "video/mp4";
        boolean video;
        boolean voice;
        boolean music;
        boolean gif;
        boolean sticker;
        boolean animatedSticker;
    }
}

class MessageObject {
    static boolean isVideoMessage(TLRPC.Message message) {
        return message.media.document.video;
    }

    static boolean isVideoDocument(TLRPC.Document document) {
        return document.video;
    }

    static boolean isMusicMessage(TLRPC.Message message) {
        return message.media.document.music;
    }

    static boolean isGifMessage(TLRPC.Message message) {
        return message.media.document.gif;
    }

    static boolean isStickerMessage(TLRPC.Message message) {
        return message.media.document.sticker;
    }

    static boolean isAnimatedStickerMessage(TLRPC.Message message) {
        return message.media.document.animatedSticker;
    }
}

class DialogObject {
    static boolean isEncryptedDialog(long id) {
        return id == Long.MAX_VALUE;
    }
}

class FileLoader {
    static final FileLoader loader = new FileLoader();
    File original;
    final HashMap<TLRPC.Document, File> paths = new HashMap<>();
    final HashSet<String> loading = new HashSet<>();

    static FileLoader getInstance(int account) {
        return loader;
    }

    File getPathToMessage(TLRPC.Message message) {
        return original;
    }

    File getPathToAttach(TLRPC.Document document) {
        return paths.get(document);
    }

    boolean isLoadingFile(String name) {
        return loading.contains(name);
    }
}
